# host-compiled checks of the DRBG against NIST CAVP vectors, one binary
# per SHA-256 backend so both compile paths stay honest
CIFRA = ../cifra
MBEDTLS = ../../libs/mpy/lib/mbedtls
CAVP_SRC = hmac_drbg_cavp.c ../hmac_drbg.c
CAVP_DEPS = $(CAVP_SRC) ../hmac_drbg.h hmac_drbg_cavp_vectors.h
CAVP_CC = $(CC) -Wall -Werror -O1 -I.. -DNGU_HMAC_DRBG_NO_MPCONFIG

cavp-cifra: $(CAVP_DEPS) $(CIFRA)/sha256.c $(CIFRA)/blockwise.c
	$(CAVP_CC) -I$(CIFRA) -I$(CIFRA)/ext -o $@ \
		$(CAVP_SRC) $(CIFRA)/sha256.c $(CIFRA)/blockwise.c

cavp-mbedtls: $(CAVP_DEPS) $(MBEDTLS)/library/sha256.c $(MBEDTLS)/library/platform_util.c
	$(CAVP_CC) -DMICROPY_SSL_MBEDTLS=1 -I$(MBEDTLS)/include -o $@ \
		$(CAVP_SRC) $(MBEDTLS)/library/sha256.c $(MBEDTLS)/library/platform_util.c

.PHONY: cavp
cavp: cavp-cifra cavp-mbedtls
	./cavp-cifra
	./cavp-mbedtls

# The entropy-backend gates in ../random.c must fail closed at compile time:
# an absent or false attestation stops the build; only the exact value 1
# passes. Syntax-only builds; needs headers generated by a unix-port build.
# ESP32 cases compile against the test double in gate-stubs/.
MPY_UNIX = ../../libs/mpy/ports/unix
GATE_CC = $(CC) -fsyntax-only -std=gnu99 -DUNIX -DMICROPY_SSL_MBEDTLS=1 \
	-I../../libs/mpy -I$(MPY_UNIX) -I$(MPY_UNIX)/build-ngu -I../../var \
	-I$(MBEDTLS)/include -I.. -I../../libs
GATE_STM = $(GATE_CC) -DMICROPY_PY_STM=1 ../random.c
GATE_ESP = $(GATE_CC) -Igate-stubs -DESP_PLATFORM=1 ../random.c

.PHONY: gates
gates:
	@test -d $(MPY_UNIX)/build-ngu || \
		{ echo "gates: needs a unix-port build first (make quick)"; exit 1; }
	! $(GATE_STM) 2>/dev/null                                    # no attestation
	! $(GATE_STM) -DNGU_STM32_RNG_GET_IS_HARDWARE=0 2>/dev/null  # false attestation
	$(GATE_STM) -DNGU_STM32_RNG_GET_IS_HARDWARE=1                # true attestation
	! $(GATE_ESP) 2>/dev/null                                    # no attestation
	! $(GATE_ESP) -DNGU_ESP32_RNG_IS_TRUE_RANDOM=0 2>/dev/null   # false attestation
	$(GATE_ESP) -DNGU_ESP32_RNG_IS_TRUE_RANDOM=1                 # true attestation
	! $(GATE_STM) -DNGU_STM32_RNG_GET_IS_HARDWARE=1 \
		-DMICROPY_PY_THREAD=1 -DMICROPY_PY_THREAD_GIL=0 \
		2>/dev/null                                              # no-GIL threads refused
	$(GATE_STM) -DNGU_STM32_RNG_GET_IS_HARDWARE=1 \
		-DMICROPY_PY_THREAD=1 -DMICROPY_PY_THREAD_GIL=1          # GIL threads fine
	out=$$($(MAKE) -s -C ../.. -f makefile.stm32 show-rng-attest \
		BOARD=NUCLEO_F401RE) && test -z "$$out"                  # wrapper: other boards don't attest
	out=$$($(MAKE) -s -C ../.. -f makefile.stm32 show-rng-attest) \
		&& test "$$out" = "-DNGU_STM32_RNG_GET_IS_HARDWARE=1"    # wrapper: verified board does
	$(MAKE) -s -C ../.. -f makefile.stm32 -n 2>/dev/null \
		| grep -q ports/stm32                                    # wrapper: default goal enters the stm32 port
	@echo "PASS - compile gates"

# deterministic tests of the entropy health rule (pure logic, host-compiled)
entropy-health-test: entropy_health_test.c ../entropy_health.h
	$(CC) -Wall -Werror -O1 -I.. -o $@ entropy_health_test.c

.PHONY: health
health: entropy-health-test
	./entropy-health-test

# runs the test compiled in, not here
# or, on target
#	 import ngu_tests.run
run:
	$(MPY) run.py
